# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=nyc-taxi-trips
KAFKA_DLQ_TOPIC=nyc-taxi-trips-dlq
KAFKA_CONSUMER_GROUP_ID=nyc-taxi-etl-consumer
KAFKA_CONSUMER_TIMEOUT_MS=5000
KAFKA_PRODUCER_ACKS=all
KAFKA_PRODUCER_RETRIES=5
KAFKA_BATCH_SIZE=500
KAFKA_BATCH_TIMEOUT_SECONDS=10

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_DB=taxi
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_ASYNC_INSERT=1
CLICKHOUSE_WAIT_FOR_ASYNC_INSERT=1

# Monitoring
PROMETHEUS_PORT_PRODUCER=9100
PROMETHEUS_PORT_CONSUMER=9101
HEALTH_PORT=8000
LOG_LEVEL=INFO

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ETL
PARQUET_FILE_PATH=data/raw/yellow_tripdata_2024-01.parquet
ZONE_LOOKUP_PATH=data/reference/taxi_zone_lookup.csv
REJECTED_DIR=data/rejected
PARQUET_BATCH_SIZE=1000
