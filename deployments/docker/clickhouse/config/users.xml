<?xml version="1.0"?>
<clickhouse>

    <!-- Profiles -->
    <profiles>
        <default>
            <max_memory_usage>10000000000</max_memory_usage>
            <use_uncompressed_cache>0</use_uncompressed_cache>
            <load_balancing>random</load_balancing>
            <async_insert>1</async_insert>
            <wait_for_async_insert>1</wait_for_async_insert>
        </default>

        <etl_profile>
            <max_memory_usage>20000000000</max_memory_usage>
            <max_insert_block_size>1048576</max_insert_block_size>
            <async_insert>1</async_insert>
            <wait_for_async_insert>1</wait_for_async_insert>
            <load_balancing>random</load_balancing>
        </etl_profile>

        <readonly>
            <readonly>1</readonly>
            <max_memory_usage>5000000000</max_memory_usage>
            <load_balancing>random</load_balancing>
        </readonly>
    </profiles>

    <!-- Quotas -->
    <quotas>
        <default>
            <interval>
                <duration>3600</duration>
                <queries>0</queries>
                <errors>0</errors>
                <result_rows>0</result_rows>
                <read_rows>0</read_rows>
                <execution_time>0</execution_time>
            </interval>
        </default>
    </quotas>

    <!-- Users -->
    <users>
        <!-- ETL User -->
        <etl_user>
            <password>etl_password_secure</password>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>etl_profile</profile>
            <quota>default</quota>
        </etl_user>

        <!-- Grafana Read-Only User -->
        <readonly_user>
            <password>grafana_readonly</password>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>readonly</profile>
            <quota>default</quota>
        </readonly_user>

        <!-- Default User (Local development admin) -->
        <default>
            <password></password>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
        </default>
    </users>

</clickhouse>
